+    t = X.loco({"a": X.count_arrays(y, pred, doc, 20)[None]}, cluster)
+    row = t[t["left_out_cluster"] == 1].iloc[0]
+    keep = cluster[doc] != 1
+    assert row["f1_without"] == pytest.approx(macro_f1(y[keep], pred[keep]))
+    assert row["n_docs_left_out"] == 5
