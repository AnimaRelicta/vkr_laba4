+def _rand_preds(rng, n=300, n_docs=20):
+    y = rng.integers(0, N_CLASSES, n)
+    pred = np.where(rng.random(n) < 0.7, y, rng.integers(0, N_CLASSES, n))
+    doc = np.sort(rng.integers(0, n_docs, n))
+    return y, pred, doc
+
