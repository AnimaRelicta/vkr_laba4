+# Семейства мутаций заголовков (ТЗ, п. 3.2). Мутации применяются ПОСЛЕ split.
+# Видимость: M3, M5, M6 не попадают в train; M5, M6 не попадают и в val (hold-out семейства).
+seeds: {train_base: 1000, val: 2000, test: 3000}   # train: base + seed запуска; val/test фиксированы для всех оптимизаторов
+visibility:
+  M1: [train, val, test]
+  M2: [train, val, test]
+  M3: [val, test]          # val видит только часть синонимов (val_syn), test - все
+  M4: [train, val, test]
+  M5: [test]
+  M6: [test]
+order: [M3, M2, M5, M1, M4]   # порядок применения к заголовку; M6 - на уровне документа после остальных
+M1:
+  char_probs: [0.03, 0.06, 0.10]
