diff --git a/src/vkr/lab4/stats.py b/src/vkr/lab4/stats.py
new file mode 100644
index 0000000..eadaa62
--- /dev/null
+++ b/src/vkr/lab4/stats.py
@@ -0,0 +1,157 @@
+"""Статистика, сводный балл, Pareto и проверка гипотез (ТЗ, п. 3.6). Без torch: работает по runs.csv."""
+from __future__ import annotations
+
+import numpy as np
+import pandas as pd
+from scipy import stats as sst
+
+DIRECTION = {"f1": +1, "std": -1, "ece": -1, "steps_to_target": -1, "memory": -1}
+
+
+def bootstrap_ci(x, n: int = 10000, seed: int = 0, alpha: float = 0.05):
+    """Среднее и перцентильный bootstrap-ДИ по seed."""
+    x = np.asarray(x, dtype=float)
+    x = x[~np.isnan(x)]
+    if len(x) == 0:
+        return float("nan"), float("nan"), float("nan")
+    rng = np.random.default_rng(seed)
+    means = x[rng.integers(0, len(x), size=(n, len(x)))].mean(1)
+    return float(x.mean()), float(np.quantile(means, alpha / 2)), float(np.quantile(means, 1 - alpha / 2))
+
+
+def holm(pvals: dict) -> dict:
+    """Поправка Холма-Бонферрони."""
+    items = sorted(pvals.items(), key=lambda kv: kv[1])
+    m, out, run_max = len(items), {}, 0.0
+    for i, (k, p) in enumerate(items):
+        run_max = max(run_max, min(1.0, (m - i) * p))
+        out[k] = run_max
+    return out
+
+
+def _censored_steps(df: pd.DataFrame, budget: int) -> pd.Series:
+    s = pd.to_numeric(df["steps_to_target"], errors="coerce")
+    return s.fillna(budget)
+
+
+def summarize(main: pd.DataFrame, sel: dict, budget_steps: int, metric: str = "test_f1_main", ece_col: str = "test_ece_main") -> pd.DataFrame:
+    rows = []
+    for opt, g in main.groupby("optimizer"):
+        f1 = pd.to_numeric(g[metric], errors="coerce")
+        m, lo, hi = bootstrap_ci(f1.dropna(), sel["bootstrap_resamples"])
+        rows.append({
+            "optimizer": opt, "n_runs": len(g), "f1_mean": m, "f1_std": float(f1.std(ddof=1)) if f1.notna().sum() > 1 else float("nan"),
+            "f1_ci_lo": lo, "f1_ci_hi": hi,
+            "val_f1_mean": pd.to_numeric(g["val_f1_final"], errors="coerce").mean(),
+            "ece_mean": pd.to_numeric(g[ece_col], errors="coerce").mean(),
+            "steps_to_target_mean": _censored_steps(g, budget_steps).mean(),
+            "reached_target": int(pd.to_numeric(g["steps_to_target"], errors="coerce").notna().sum()),
+            "train_time_min": pd.to_numeric(g["train_time_s"], errors="coerce").mean() / 60,
+            "peak_mem_mb": pd.to_numeric(g["peak_mem_mb"], errors="coerce").mean(),
+            "unstable_share": pd.to_numeric(g["unstable"], errors="coerce").mean(),
+        })
+    return pd.DataFrame(rows).set_index("optimizer").sort_index()
+
+
+def _minmax(x: pd.Series, direction: int) -> pd.Series:
+    lo, hi = x.min(), x.max()
+    if not np.isfinite(lo) or hi - lo < 1e-12:
+        return pd.Series(1.0, index=x.index)      # метрики равны у всех: никого не штрафуем
+    z = (x - lo) / (hi - lo)
+    return z if direction > 0 else 1 - z
+
+
+def composite(summary: pd.DataFrame, weights: dict) -> pd.Series:
+    """40 % F1, 20 % разброс, 15 % ECE, 15 % шаги до цели, 10 % память; нормировка min-max между оптимизаторами."""
+    cols = {"f1": "f1_mean", "std": "f1_std", "ece": "ece_mean", "steps_to_target": "steps_to_target_mean", "memory": "peak_mem_mb"}
+    score = sum(weights[k] * _minmax(summary[c].fillna(summary[c].max()), DIRECTION[k]) for k, c in cols.items())
+    return score.rename("score")
+
+
+def pareto_nondominated(summary: pd.DataFrame) -> pd.Series:
+    """Недоминируемость по F1 (больше), времени (меньше) и разбросу (меньше)."""
+    pts = pd.DataFrame({"f1": -summary["f1_mean"], "t": summary["train_time_min"], "sd": summary["f1_std"].fillna(0)})
+    ok = {}
+    for a in pts.index:
+        dom = ((pts <= pts.loc[a]).all(axis=1) & (pts < pts.loc[a]).any(axis=1)).drop(a).any()
+        ok[a] = not dom
+    return pd.Series(ok, name="pareto_ok")
+
+
+def pairwise_wilcoxon(main: pd.DataFrame, winner: str, metric: str = "test_f1_main") -> pd.DataFrame:
+    """Парный Wilcoxon по seed: победитель против каждого, поправка Холма."""
+    piv = main.pivot_table(index="seed", columns="optimizer", values=metric, aggfunc="mean")
+    raw = {}
+    for o in piv.columns:
+        if o == winner:
+            continue
+        d = (piv[winner] - piv[o]).dropna()
+        raw[o] = 1.0 if len(d) == 0 or np.allclose(d, 0) else float(sst.wilcoxon(d, zero_method="wilcox", method="auto").pvalue)
+    adj = holm(raw)
+    return pd.DataFrame({"p_raw": raw, "p_holm": adj, "mean_diff": {o: float((piv[winner] - piv[o]).mean()) for o in raw}})
+
+
+def choose_winner(summary: pd.DataFrame, score: pd.Series, max_unstable: float) -> dict:
+    res = summary.join(score).join(pareto_nondominated(summary))
+    elig = res[res["unstable_share"] <= max_unstable + 1e-12]
+    if elig.empty:
+        return {"winner": None, "verdict": "ни один оптимизатор не прошёл фильтр нестабильности", "table": res}
+    ranked = elig.sort_values("score", ascending=False)
+    nd = ranked[ranked["pareto_ok"]]
+    winner = (nd.index[0] if len(nd) else ranked.index[0])
+    note = "" if ranked.index[0] == winner else f" ({ranked.index[0]} лидирует по баллу, но доминируется по Pareto)"
+    second = ranked.index[1] if len(ranked) > 1 and ranked.index[1] != winner else (ranked.index[2] if len(ranked) > 2 else None)
+    verdict, final = "победитель по сводному баллу" + note, winner
+    if second is not None:
+        a, b = res.loc[winner], res.loc[second]
+        if a["f1_ci_lo"] <= b["f1_ci_hi"] and b["f1_ci_lo"] <= a["f1_ci_hi"]:
+            verdict = f"{winner} и {second} статистически неразличимы (ДИ пересекаются): выбор по стабильности и ресурсам" + note
+            final = min([winner, second], key=lambda o: (res.loc[o, "unstable_share"], res.loc[o, "peak_mem_mb"], res.loc[o, "train_time_min"]))
+    return {"winner": winner, "second": second, "final": final, "verdict": verdict, "table": res}
+
+
+def scenario_table(main: pd.DataFrame, scenarios: list[str]) -> pd.DataFrame:
+    """Средний test Macro-F1 по сценариям, ранг, падение относительно S0."""
+    cols = {s: f"test_f1_{s}" for s in scenarios if f"test_f1_{s}" in main.columns}
+    mean = pd.DataFrame({s: main.groupby("optimizer")[c].apply(lambda x: pd.to_numeric(x, errors="coerce").mean()) for s, c in cols.items()})
+    out = mean.copy()
+    out.columns = [f"F1_{c}" for c in mean.columns]
+    for s in mean.columns:
+        out[f"rank_{s}"] = mean[s].rank(ascending=False, method="min")
+        if "S0" in mean.columns and s != "S0":
+            out[f"drop_{s}"] = mean["S0"] - mean[s]
+    return out
+
+
+def hypotheses(summary: pd.DataFrame, scen: pd.DataFrame, winner: str | None, hyp: dict, main: pd.DataFrame) -> list[dict]:
+    out = []
+    # H1: Adam и AdamW достигают цели минимум на 30 % быстрее SGD по шагам
+    if "sgd" in summary.index:
+        base = summary.loc["sgd", "steps_to_target_mean"]
+        for o in ("adam", "adamw"):
+            if o in summary.index:
+                gain = 1 - summary.loc[o, "steps_to_target_mean"] / base
+                out.append({"h": f"H1 ({o} vs sgd)", "value": f"выигрыш по шагам {gain:.1%}", "ok": bool(gain >= hyp["H1_min_speedup"])})
+    # H2: разрыв F1 лучший-худший >= 0.02 и ДИ лучшего и SGD не пересекаются
+    best, worst = summary["f1_mean"].idxmax(), summary["f1_mean"].idxmin()
+    gap = summary.loc[best, "f1_mean"] - summary.loc[worst, "f1_mean"]
+    ci_ok = None
+    if "sgd" in summary.index and best != "sgd":
+        ci_ok = bool(summary.loc[best, "f1_ci_lo"] > summary.loc["sgd", "f1_ci_hi"])
+    out.append({"h": "H2", "value": f"разрыв {gap:.4f} ({best} - {worst}); ДИ лучшего и SGD не пересекаются: {ci_ok}",
+                "ok": bool(gap >= hyp["H2_min_gap"] and (ci_ok is None or ci_ok))})
+    # H3: победитель в топ-3 на S3-S5
+    if winner is not None:
+        ranks = {s: int(scen.loc[winner, f"rank_{s}"]) for s in ("S3", "S4", "S5") if f"rank_{s}" in scen.columns}
+        out.append({"h": "H3", "value": f"ранги {winner}: {ranks}", "ok": bool(ranks) and all(r <= 3 for r in ranks.values())})
+    out.append({"h": "H4", "value": "проверяется на этапе 8 (каскад с LLM), см. TODO.md", "ok": None})
+    return out
+
+
+def fmt_table(df: pd.DataFrame, floatfmt: str = "{:.4f}") -> str:
+    d = df.reset_index()
+    head = "| " + " | ".join(map(str, d.columns)) + " |"
+    sep = "| " + " | ".join("---" for _ in d.columns) + " |"
+    rows = ["| " + " | ".join(floatfmt.format(v) if isinstance(v, (float, np.floating)) and np.isfinite(v) else str(v) for v in r) + " |"
+            for r in d.itertuples(index=False)]
+    return "\n".join([head, sep] + rows)
diff --git a/src/vkr/lab4/train.py b/src/vkr/lab4/train.py
new file mode 100644
index 0000000..457badd
--- /dev/null
+++ b/src/vkr/lab4/train.py
@@ -0,0 +1,205 @@
+"""Один запуск обучения: общий цикл для всех оптимизаторов (ТЗ, п. 3.3-3.5)."""
+from __future__ import annotations
+
+import json
+import math
+import time
+from dataclasses import asdict
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+import torch
+from torch import nn
+
+from .labels import LABEL2ID, N_CLASSES
+from .metrics import ece, macro_f1
+from .models import n_trainable
+from .mutations import build_set, markov_frames
+from .optimizers import make_optimizer
+from .spec import RunSpec
+
+
+class Context:
+    """Всё, что одинаково для всех запусков: данные, фиксированные val/test-мутации, бэкенд, устройство."""
+
+    def __init__(self, cfg, splits: dict, backend, device: str):
+        self.cfg, self.splits, self.backend, self.device = cfg, splits, backend, device
+        t, mc, sc = cfg.protocol["train"], cfg.mutations, cfg.scenarios
+        self.val = build_set(splits["val"], sc["val_mutations"], "val", mc, mc["seeds"]["val"], t["copies_val"], keep_original=True)
+        self.test_sets: dict[str, pd.DataFrame] = {}
+        for name, s in sc["scenarios"].items():
+            if "mutations" in s:
+                copies = 1 if name == "S0" else t["copies_test"]
+                self.test_sets[name] = build_set(splits["test"], s["mutations"], "test", mc, mc["seeds"]["test"], copies,
+                                                 keep_original=(name == "S0"))
+        self.markov = list(markov_frames(splits["test"], sc["scenarios"]["S5"], mc, mc["seeds"]["test"])) \
+            if "S5" in sc["scenarios"] else []
+
+    def train_set(self, seed: int) -> pd.DataFrame:
+        t, mc = self.cfg.protocol["train"], self.cfg.mutations
+        return build_set(self.splits["train"], self.cfg.scenarios["train_mutations"], "train", mc,
+                         mc["seeds"]["train_base"] + seed, t["copies_train"], keep_original=True)
+
+
+def _labels(df: pd.DataFrame) -> np.ndarray:
+    return df["label"].map(LABEL2ID).to_numpy()
+
+
+@torch.no_grad()
+def predict_probs(model, backend, df: pd.DataFrame, device, cache: dict | None = None, bs: int = 256) -> np.ndarray:
+    """Вероятности классов; одинаковые (заголовок, значения) считаются один раз."""
+    model.eval()
+    keys = list(zip(df["header_text"], df["values_sample"]))
+    cache = {} if cache is None else cache
+    todo = [k for k in dict.fromkeys(keys) if k not in cache]
+    for i in range(0, len(todo), bs):
+        chunk = todo[i:i + bs]
+        batch = backend.collate([backend.encode_one(h, v) for h, v in chunk], device)
+        p = torch.softmax(model(**batch).float(), dim=1).cpu().numpy()
+        for k, row in zip(chunk, p):
+            cache[k] = row
+    return np.stack([cache[k] for k in keys])
+
+
+def _peak_mem_mb(device: str, rss_peak: float) -> float:
+    if device.startswith("cuda"):
+        return torch.cuda.max_memory_allocated() / 2**20
+    return rss_peak
+
+
+def _rss_mb() -> float:
+    import psutil
+    return psutil.Process().memory_info().rss / 2**20
+
+
+def _sync(device: str):
+    if device.startswith("cuda"):
+        torch.cuda.synchronize()
+
+
+def train_run(spec: RunSpec, ctx: Context, log_dir: Path | None = None, eval_scenarios: bool = True,
+              save_probs_dir: Path | None = None) -> dict:
+    cfg, backend, device = ctx.cfg, ctx.backend, ctx.device
+    tcfg = cfg.protocol["train"]
+    steps = spec.steps or tcfg["steps"]
+    target = tcfg["target_val_f1"]
+    if device.startswith("cuda"):
+        torch.cuda.empty_cache()
+        torch.cuda.reset_peak_memory_stats()
+    rng = np.random.default_rng(spec.seed)
+    torch.manual_seed(spec.seed)
+
+    tr = ctx.train_set(spec.seed)
+    y_all = torch.tensor(_labels(tr), dtype=torch.long)
+    items = [backend.encode_one(h, v) for h, v in zip(tr["header_text"], tr["values_sample"])]
+    val_y = _labels(ctx.val)
+
+    model = backend.build_model(spec.seed).to(device)
+    params = [p for p in model.parameters() if p.requires_grad]
+    opt = make_optimizer(spec.optimizer, params, spec.lr, cfg.grid, spec.weight_decay)
+    warm = max(1, int(round(tcfg["warmup_frac"] * steps)))
+    sched = torch.optim.lr_scheduler.LambdaLR(
+        opt, lambda s: (s + 1) / warm if s < warm else 0.5 * (1 + math.cos(math.pi * (s - warm) / max(1, steps - warm))))
+    micro = backend.micro_batch or spec.batch_size
+    loss_fn = nn.CrossEntropyLoss(reduction="sum")
+
+    log, val_curve = [], []
+    steps_to_target, reason = None, ""
+    win_losses, win_means, running_min = [], [], math.inf
+    rss_peak = _rss_mb()
+    perm, ptr = rng.permutation(len(items)), 0
+    eval_time, t_start = 0.0, time.perf_counter()
+    done_steps = 0
+
+    for step in range(steps):
+        if ptr + spec.batch_size > len(perm):
+            perm, ptr = rng.permutation(len(items)), 0
+        idx = perm[ptr:ptr + spec.batch_size]
+        ptr += spec.batch_size
+        model.train()
+        opt.zero_grad(set_to_none=True)
+        total = 0.0
+        for j in range(0, len(idx), micro):
+            sub = idx[j:j + micro]
+            batch = backend.collate([items[i] for i in sub], device)
+            logits = model(**batch)
+            loss = loss_fn(logits.float(), y_all[sub].to(device)) / len(idx)
+            loss.backward()
+            total += loss.item()
+        gnorm = float(torch.nn.utils.clip_grad_norm_(params, tcfg["grad_clip"]))
+        if not math.isfinite(total) or not math.isfinite(gnorm):
+            reason = "nan_inf"
+            done_steps = step
+            break
+        opt.step()
+        sched.step()
+        done_steps = step + 1
+        win_losses.append(total)
+        if done_steps % tcfg["log_every"] == 0:
+            w = float(np.mean(win_losses))
+            win_losses = []
+            win_means.append(w)
+            running_min = min(running_min, w)
+            log.append({"step": done_steps, "train_loss": w, "grad_norm": gnorm})
+            rss_peak = max(rss_peak, _rss_mb())
+            if len(win_means) > 2 and w > 3 * running_min and not reason:
+                reason = "loss_growth_3x"
+        if done_steps % tcfg["eval_every"] == 0:
+            _sync(device)
+            t0 = time.perf_counter()
+            f1 = macro_f1(val_y, predict_probs(model, backend, ctx.val, device).argmax(1))
+            _sync(device)
+            eval_time += time.perf_counter() - t0
+            val_curve.append((done_steps, f1))
+            log.append({"step": done_steps, "val_f1": f1})
+            if steps_to_target is None and f1 >= target:
+                steps_to_target = done_steps
+        if (time.perf_counter() - t_start - eval_time) / 60 > tcfg["time_limit_min"]:
+            reason = reason or "time_limit"
+            break
+    _sync(device)
+    train_time = time.perf_counter() - t_start - eval_time
+
+    row = {**asdict(spec), "steps": steps, "run_id": spec.run_id, "backend": backend.name, "steps_done": done_steps,
+           "n_trainable": n_trainable(model), "train_time_s": round(train_time, 2),
+           "final_loss": win_means[-1] if win_means else float("nan")}
+    if reason == "nan_inf":
+        row.update(val_f1_final=float("nan"), val_f1_best=float("nan"))
+    else:
+        cache: dict = {}
+        vf = macro_f1(val_y, predict_probs(model, backend, ctx.val, device, cache).argmax(1))
+        val_curve.append((done_steps, vf))
+        row.update(val_f1_final=vf, val_f1_best=max(f for _, f in val_curve))
+        if steps_to_target is None:
+            reason = reason or "target_not_reached"
+    row["steps_to_target"] = steps_to_target if steps_to_target is not None else ""
+    row["unstable"] = int(bool(reason))
+    row["unstable_reason"] = reason
+
+    if eval_scenarios and reason != "nan_inf":
+        cache = {}
+        probs_out = {}
+        for name, df in ctx.test_sets.items():
+            P = predict_probs(model, backend, df, device, cache)
+            y = _labels(df)
+            row[f"test_f1_{name}"] = macro_f1(y, P.argmax(1))
+            row[f"test_ece_{name}"] = ece(P, y, cfg.protocol["selection"]["ece_bins"])
+            if name in ("S0", "S3", "S4", "MAIN"):
+                probs_out[name] = P.astype(np.float32)
+        if ctx.markov:
+            f1s = []
+            for frame, _chain in ctx.markov:
+                f1s.append(macro_f1(_labels(frame), predict_probs(model, backend, frame, device, cache).argmax(1)))
+            row["test_f1_S5"] = float(np.mean(f1s))
+            row["test_f1_S5_sd"] = float(np.std(f1s))
+        main = cfg.scenarios["main_scenario"]
+        row["test_f1_main"], row["test_ece_main"] = row.get(f"test_f1_{main}"), row.get(f"test_ece_{main}")
+        if save_probs_dir is not None:
+            save_probs_dir.mkdir(parents=True, exist_ok=True)
+            np.savez_compressed(save_probs_dir / f"{spec.run_id}.npz", **probs_out)
+    row["peak_mem_mb"] = round(_peak_mem_mb(device, max(rss_peak, _rss_mb())), 1)
+    if log_dir is not None:
+        log_dir.mkdir(parents=True, exist_ok=True)
+        (log_dir / f"{spec.run_id}.jsonl").write_text("\n".join(json.dumps(x, ensure_ascii=False) for x in log), encoding="utf-8")
+    return row
