+# Сетка LR и параметры оптимизаторов. Одинаковая процедура для всех: 7 точек на лог-сетке,
+# выбор по среднему val Macro-F1 на двух tuning-seed (100, 101).
+optimizers:
+  sgd:      {family: sgd,  momentum: 0.0, nesterov: false, weight_decay: 0.0}
+  momentum: {family: sgd,  momentum: 0.9, nesterov: false, weight_decay: 0.0}
+  nesterov: {family: sgd,  momentum: 0.9, nesterov: true,  weight_decay: 0.0}
+  adagrad:  {family: adam, weight_decay: 0.0}
+  rmsprop:  {family: adam, alpha: 0.99, weight_decay: 0.0}
+  adam:     {family: adam, betas: [0.9, 0.999], weight_decay: 0.0}
+  adamw:    {family: adam, betas: [0.9, 0.999], weight_decay: 0.01}   # decoupled weight decay - суть метода
+  radam:    {family: adam, betas: [0.9, 0.999], weight_decay: 0.0}
+lr_grid:                       # 7 значений, логарифмическая сетка
+  adam: {min: 1.0e-4, max: 1.0e-1, n: 7}   # «Adam-семейство»: адаптивные методы
+  sgd:  {min: 1.0e-3, max: 1.0,    n: 7}   # «SGD-семейство»
+sensitivity:
+  optimizers_top: 3            # топ-3 по сводному баллу + SGD
+  lr_multipliers: [0.1, 0.3333333, 1.0, 3.0, 10.0]
